# PostgreSQL — usuário dono do schema (migrations, seed, reset)
DATABASE_URL=postgres://cubetrack:cubetrack@localhost:5432/cubetrack
# PostgreSQL — usuário da aplicação (sem BYPASSRLS, membro de app_rw)
DATABASE_APP_URL=postgres://cubetrack_app:cubetrack_app@localhost:5432/cubetrack
# Testes de integração: URL de um superusuário; cada execução cria um banco isolado.
# Se ausente, os testes sobem um PostgreSQL via Testcontainers (requer Docker).
TEST_DATABASE_URL=postgres://cubetrack:cubetrack@localhost:5432/postgres

REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=cubetrack
S3_SECRET_KEY=cubetrack-secret
S3_BUCKET=cubetrack-files
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=cubetrack-dev-master-key
SMTP_URL=smtp://localhost:1025
