# ─── Ambiente ──────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── PostgreSQL ────────────────────────────────────────────────────────────────────────────
# Usuário dono do schema (migrations, seed, reset)
DATABASE_URL=postgres://cubetrack:cubetrack@localhost:5432/cubetrack
# Aplicação (sem BYPASSRLS, membro de app_rw)
DATABASE_APP_URL=postgres://cubetrack_app:cubetrack_app@localhost:5432/cubetrack
# Fluxos de autenticação (membro de app_auth — ADR 0028)
DATABASE_AUTH_URL=postgres://cubetrack_auth:cubetrack_auth@localhost:5432/cubetrack
# Relay do outbox no worker (membro de app_relay — ADR 0028)
DATABASE_RELAY_URL=postgres://cubetrack_relay:cubetrack_relay@localhost:5432/cubetrack
DATABASE_POOL_MAX=20
# Testes de integração: URL de um superusuário; cada execução cria um banco isolado.
# Se ausente, os testes sobem um PostgreSQL via Testcontainers (requer Docker).
TEST_DATABASE_URL=postgres://cubetrack:cubetrack@localhost:5432/postgres

# ─── Redis ─────────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API (apps/api) ────────────────────────────────────────────────────────────────────────
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
# Resolução de tenant por subdomínio: {slug}.BASE_DOMAIN (alternativa: header X-Tenant)
BASE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000
# embedded: gateway Socket.IO no mesmo processo; separate: processo próprio (main.realtime)
REALTIME_MODE=embedded
REALTIME_PORT=3002
# Segredos — gere valores novos fora de dev: `openssl rand -base64 48` / `openssl rand -base64 32`
JWT_SECRET=dev-only-change-me-0123456789-abcdefghijklmnopqrstuvwxyz
JWT_ISSUER=cube-track
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
# Chave AES-256-GCM (32 bytes em base64) para segredos de MFA e afins
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=
COOKIE_SECURE=false
COOKIE_DOMAIN=
RATE_LIMIT_PER_MINUTE=600
UPLOAD_MAX_BYTES=104857600
UPLOAD_URL_TTL_SECONDS=900

# OAuth (opcional) — deixe vazio para desativar o provedor
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=organizations

# ─── Armazenamento (S3 compatível — MinIO em dev) ────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=cubetrack
S3_SECRET_KEY=cubetrack-secret
S3_BUCKET=cubetrack-files
S3_FORCE_PATH_STYLE=true

# ─── Busca (Meilisearch) ───────────────────────────────────────────────────────────────────
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=cubetrack-dev-master-key
MEILI_API_KEY=cubetrack-dev-master-key

# ─── Worker (apps/worker) ──────────────────────────────────────────────────────────────────
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=CUBE TRACK <nao-responda@cubetrack.com.br>
# clamd (perfil "antivirus" do docker compose) ou disabled (proibido em produção)
ANTIVIRUS_MODE=disabled
CLAMD_HOST=localhost
CLAMD_PORT=3310
OUTBOX_POLL_MS=500
OUTBOX_BATCH_SIZE=200
OUTBOX_RETENTION_DAYS=7
WORKER_CONCURRENCY=8
# Painel Bull Board em http://localhost:3010/admin/queues (desativado sem usuário/senha)
BOARD_PORT=3010
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=dev-only-change-me

# ─── Observabilidade ───────────────────────────────────────────────────────────────────────
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_PORT=9464
