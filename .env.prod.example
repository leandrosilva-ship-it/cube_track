# CUBE TRACK — variáveis para o deploy de UMA VM (docker-compose.prod.yml).
# Copie para .env.prod e preencha. NUNCA versione o .env.prod de verdade (já está no .gitignore).

# ── Endereços públicos ──────────────────────────────────────────────────────────────────────
# No começo, sem domínio ainda: use o IP externo da VM, ex.: http://34.123.45.67
# Depois de configurar um domínio (ver docs/deploy-vm.md §6), troque por https://app.seudominio.com.br
# e https://api.seudominio.com.br.
PUBLIC_WEB_URL=http://TROQUE-PELO-IP-OU-DOMINIO
PUBLIC_API_URL=http://TROQUE-PELO-IP-OU-DOMINIO:3001
BASE_DOMAIN=TROQUE-PELO-IP-OU-DOMINIO
# true SÓ depois de HTTPS estar configurado (domínio + Caddy/TLS) — em HTTP puro, deixe false,
# senão o navegador descarta o cookie de sessão e o login quebra.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Segredos — gere um valor novo para cada um destes (rode no terminal da própria VM) ──────
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (precisa ter exatamente 32 bytes decodificados — use esse comando)
ENCRYPTION_KEY=
# openssl rand -hex 24
INBOUND_EMAIL_WEBHOOK_SECRET=
# openssl rand -hex 16
BULL_BOARD_PASSWORD=
BULL_BOARD_USER=admin

# ── Banco de dados (senha do superusuário "cubetrack") ───────────────────────────────────────
# openssl rand -hex 16 — este banco NÃO fica exposto à internet (só outros containers o alcançam).
POSTGRES_PASSWORD=

# ── Armazenamento de arquivos (MinIO, interno — não exposto à internet) ─────────────────────
# openssl rand -hex 16
MINIO_ROOT_PASSWORD=

# ── Busca (Meilisearch, interno — não exposto à internet) ──────────────────────────────────
# openssl rand -hex 16
MEILI_MASTER_KEY=

# ── E-mail (opcional — sem isto, convites/notificações por e-mail não saem, o resto funciona) ─
MAIL_REPLY_DOMAIN=reply.seudominio.com.br
SMTP_URL=
EMAIL_FROM=CUBE PROJECT <nao-responda@seudominio.com.br>

# ── Billing/Stripe (opcional — deixe em branco para desativar cobrança por cartão) ──────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_change_me
