# CUBE TRACK — variáveis para o deploy de UMA VM (docker-compose.prod.yml).
# Copie para .env.prod e preencha. NUNCA versione o .env.prod de verdade (já está no .gitignore).

# ── Domínio e HTTPS (Caddy com Let's Encrypt automático, já incluído no docker-compose.prod.yml) ─
# IMPORTANTE: reserve um Elastic IP (EC2 -> Elastic IPs -> Alocar, associar à instância) ANTES de
# preencher isto — sem ele o IP muda a cada reinício da VM e o domínio/certificado quebram juntos.
#
# Domínio próprio: aponte dois registros DNS tipo A para o Elastic IP (ex.: app.seudominio.com.br
# e api.seudominio.com.br) e use-os abaixo.
#
# Sem domínio próprio ainda: use nip.io, de graça — troque os pontos do IP por hífens.
# Ex.: Elastic IP 34.123.45.67 -> APP_DOMAIN=app.34-123-45-67.nip.io
#                                  API_DOMAIN=api.34-123-45-67.nip.io
APP_DOMAIN=app.TROQUE-PELO-IP-COM-HIFENS.nip.io
API_DOMAIN=api.TROQUE-PELO-IP-COM-HIFENS.nip.io
# Mesmos valores de APP_DOMAIN/API_DOMAIN acima, com o prefixo https:// (e sem porta — o Caddy
# cuida do 443). Preencha os quatro em conjunto; nunca deixe um em HTTP e outro em HTTPS.
PUBLIC_WEB_URL=https://app.TROQUE-PELO-IP-COM-HIFENS.nip.io
PUBLIC_API_URL=https://api.TROQUE-PELO-IP-COM-HIFENS.nip.io
BASE_DOMAIN=app.TROQUE-PELO-IP-COM-HIFENS.nip.io
# true com HTTPS (padrão desde que o Caddy entrou no compose) — só volte para false se estiver de
# propósito testando em HTTP puro sem domínio nenhum (nesse caso PUBLIC_WEB_URL/PUBLIC_API_URL
# também voltam a http://SEU-IP, sem o Caddy na frente).
COOKIE_SECURE=true
COOKIE_DOMAIN=

# ── Segredos — gere um valor novo para cada um destes (rode no terminal da própria VM) ──────
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (precisa ter exatamente 32 bytes decodificados — use esse comando)
ENCRYPTION_KEY=
# openssl rand -hex 24
INBOUND_EMAIL_WEBHOOK_SECRET=
# openssl rand -hex 16
BULL_BOARD_PASSWORD=
BULL_BOARD_USER=admin

# ── Banco de dados (senha do superusuário "cubetrack") ───────────────────────────────────────
# openssl rand -hex 16 — este banco NÃO fica exposto à internet (só outros containers o alcançam).
POSTGRES_PASSWORD=

# ── Armazenamento de arquivos (MinIO, interno — não exposto à internet) ─────────────────────
# openssl rand -hex 16
MINIO_ROOT_PASSWORD=

# ── Busca (Meilisearch, interno — não exposto à internet) ──────────────────────────────────
# openssl rand -hex 16
MEILI_MASTER_KEY=

# ── E-mail (opcional — sem isto, convites/notificações por e-mail não saem, o resto funciona) ─
MAIL_REPLY_DOMAIN=reply.seudominio.com.br
SMTP_URL=
EMAIL_FROM=CUBE PROJECT <nao-responda@seudominio.com.br>

# ── Billing/Stripe (opcional — deixe em branco para desativar cobrança por cartão) ──────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_change_me_0123456789
