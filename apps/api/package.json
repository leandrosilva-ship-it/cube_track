{
  "name": "@cube-track/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"node --enable-source-maps --import ./dist/instrumentation.js dist/main.js\"",
    "start": "node --enable-source-maps --import ./dist/instrumentation.js dist/main.js",
    "start:realtime": "node --enable-source-maps --import ./dist/instrumentation.js dist/main.realtime.js",
    "openapi:export": "node --import ./dist/instrumentation.js dist/openapi-export.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.920.0",
    "@aws-sdk/s3-request-presigner": "^3.920.0",
    "@cube-track/db": "workspace:*",
    "@cube-track/shared": "workspace:*",
    "@nestjs/apollo": "^13.2.1",
    "@nestjs/common": "^11.1.8",
    "@nestjs/core": "^11.1.8",
    "@nestjs/graphql": "^13.2.0",
    "@nestjs/platform-express": "^11.1.8",
    "@nestjs/platform-socket.io": "^11.1.8",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/websockets": "^11.1.8",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-prometheus": "^0.205.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/instrumentation-express": "^0.54.0",
    "@opentelemetry/instrumentation-http": "^0.205.0",
    "@opentelemetry/instrumentation-ioredis": "^0.53.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.51.0",
    "@opentelemetry/instrumentation-pg": "^0.58.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.205.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.61.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.0",
    "fractional-indexing": "^3.2.0",
    "graphql": "^16.11.0",
    "ioredis": "^5.8.2",
    "jose": "^6.1.0",
    "meilisearch": "^0.53.0",
    "nestjs-pino": "^4.4.1",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cube-track/config": "workspace:*",
    "@cube-track/testing": "workspace:*",
    "@nestjs/testing": "^11.1.8",
    "@swc/core": "^1.13.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "s3rver": "^3.7.1",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "unplugin-swc": "^1.5.8",
    "vitest": "^3.2.4"
  }
}
