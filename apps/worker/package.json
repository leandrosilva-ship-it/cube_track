{
  "name": "@cube-track/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"node --enable-source-maps --import ./dist/instrumentation.js dist/main.js\"",
    "start": "node --enable-source-maps --import ./dist/instrumentation.js dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.920.0",
    "@bull-board/api": "^6.14.0",
    "@bull-board/express": "^6.14.0",
    "@cube-track/db": "workspace:*",
    "@cube-track/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-prometheus": "^0.205.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/instrumentation-ioredis": "^0.53.0",
    "@opentelemetry/instrumentation-pg": "^0.58.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.205.0",
    "bullmq": "^5.61.0",
    "decimal.js-light": "2.5.1",
