    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.3",
    "eslint": "^9.39.1",
    "s3rver": "^3.7.1",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
