{
  "title": "CUBE TRACK — Realtime propagation",
  "uid": "cube-track-realtime",
  "description": "Métricas de negócio do gateway realtime (ADR 0027), emitidas por apps/api/src/core/observability/metrics.ts: cube_realtime_events_delivered_total, cube_realtime_connections, cube_realtime_propagation_ms. Meta de propagação: p95 < 300ms (docs/realtime-events.md).",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["cube-track", "realtime"],
  "panels": [
    {
      "id": 1,
      "title": "Propagação p50 / p95 / p99 (ms) — meta p95 < 300ms",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(cube_realtime_propagation_ms_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(cube_realtime_propagation_ms_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(cube_realtime_propagation_ms_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "thresholds": [{ "value": 300, "colorMode": "critical", "op": "gt", "line": true }]
    },
    {
      "id": 2,
      "title": "Conexões WebSocket ativas",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum(cube_realtime_connections)" }]
    },
    {
      "id": 3,
      "title": "Eventos entregues por minuto",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(cube_realtime_events_delivered_total[1m])) * 60",
          "legendFormat": "eventos/min"
        }
      ]
    },
    {
      "id": 4,
      "title": "Conexões ativas agora",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "targets": [{ "expr": "sum(cube_realtime_connections)" }]
    },
    {
      "id": 5,
      "title": "p95 de propagação agora (ms)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(cube_realtime_propagation_ms_bucket[5m])) by (le))"
        }
      ]
    }
  ]
}
