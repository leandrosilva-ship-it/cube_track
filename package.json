{
  "name": "cube-track",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @cube-track/db db:generate",
    "db:migrate": "pnpm --filter @cube-track/db db:migrate",
    "db:seed": "pnpm --filter @cube-track/db db:seed",
    "db:reset": "pnpm --filter @cube-track/db db:reset",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:seed:large": "pnpm --filter @cube-track/db db:seed:large"
  },
  "devDependencies": {
    "@cube-track/config": "workspace:*",
    "prettier": "3.6.2",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  }
}
